# 開発環境用Dockerfile
FROM ubuntu:24.04

# 環境変数
ENV DEBIAN_FRONTEND=noninteractive
ENV CMAKE_BUILD_TYPE=Debug

# 必要なパッケージのインストール
RUN apt-get update && apt-get install -y \
    build-essential \
    cmake \
    git \
    libssl-dev \
    pkg-config \
    gcc-13 \
    g++-13 \
    curl \
    vim \
    gdb \
    valgrind \
    && rm -rf /var/lib/apt/lists/*

# GCC 13をデフォルトに設定
RUN update-alternatives --install /usr/bin/gcc gcc /usr/bin/gcc-13 130 \
    --slave /usr/bin/g++ g++ /usr/bin/g++-13 \
    --slave /usr/bin/gcov gcov /usr/bin/gcov-13

# 作業ディレクトリの設定
WORKDIR /app

# Crowフレームワークのクローン
RUN git clone https://github.com/CrowCpp/Crow.git third_party/crow

# 開発用スクリプトのコピー
COPY scripts/dev-entrypoint.sh /usr/local/bin/
RUN chmod +x /usr/local/bin/dev-entrypoint.sh

# ユーザーの作成
RUN useradd -m -s /bin/bash homeserver \
    && usermod -aG sudo homeserver

# 権限の設定
RUN echo "homeserver ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers

# ユーザーの切り替え
USER homeserver

# ポートの公開
EXPOSE 8080

# 開発用エントリーポイント
ENTRYPOINT ["/usr/local/bin/dev-entrypoint.sh"] 