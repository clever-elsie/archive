server{ # httpをhttpsにリダイレクト
  listen 80;
  listen [::]:80;
  return 301 https://$host$request_uri;
}

server{
  server_tokens off;
  listen 443 ssl http2;
  listen [::]:443 ssl http2;

  ssl_certificate /etc/nginx/ssl/server.crt;
  ssl_certificate_key /etc/nginx/ssl/server.key;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_session_timeout 30m;
	ssl_ciphers 'ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384';
  # 暗号スイートの対応は`openssl ciphers -v`
	ssl_prefer_server_ciphers on;

  add_header Strict-transport-Security "max-age=31536000; includeSubDomains; always";
  add_header X-Content-Type-Options "nosniff" always;
  add_header X-Frame-Options "SAMEORIGIN" always;
  add_header Referrer-Policy "strict-origin-when-cross-origin" always;

  disable_symlinks off;

  location / { # HTMLファイルなどの公開コンテンツ
    root /home/user/archive/client/public;
    index index.html;
    try_files $uri $uri/ =404;
  }

  location /static/ { # .css, .js ファイルなどの静的アセット
    alias /home/user/archive/client/src/;
    access_log off;
    # HTMLとJavaScript/CSSの世代が混在しないよう、更新を即時反映する。
    # 将来ファイル名ハッシュを導入する場合は、その世代で長期cacheへ変更できる。
    expires -1;
    add_header Cache-Control "no-cache, must-revalidate";
    try_files $uri $uri/ =404;
  }

  location /req{ # サーバサイドへのプロキシ
    proxy_pass https://localhost:3000;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-User $host;
    proxy_set_header X-Forwarded-Port $server_port;
    proxy_redirect off;
    proxy_read_timeout 600s;
  }

	location /req/viewer/content/ { # 動画/音声のストリーミング最適化
		proxy_pass https://localhost:3000;
		proxy_set_header Host $host;
		proxy_set_header X-Real-IP $remote_addr;
		proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
		proxy_set_header X-Forwarded-Proto $scheme;
		proxy_set_header X-Forwarded-User $host;
		proxy_set_header X-Forwarded-Port $server_port;
		proxy_request_buffering off;
		proxy_buffering off;
		proxy_redirect off;
		proxy_read_timeout 3600s;
	}

	location /_protected_media/{ # 内部ファイル配信用（直接アクセス不可）
		internal;
		alias /home/user/archive/data/;
		add_header X-Content-Type-Options nosniff;
	}

  location /favicon{ # ファビコンはお好みで
    empty_gif;
    access_log off;
    log_not_found off;
  }
}
